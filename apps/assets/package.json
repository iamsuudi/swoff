{
  "name": "@swoff/assets",
  "version": "0.0.1",
  "type": "module",
  "description": "Universal PWA asset generator — icons, splash screens, favicons, OG images, manifest.json",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "swoff-assets": "bin/swoff-assets"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "keywords": [
    "pwa",
    "assets",
    "icons",
    "splash-screens",
    "favicon",
    "og-image"
  ],
  "author": "Swoff",
  "license": "MIT",
  "dependencies": {
    "jimp": "^1.6.0",
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.0.0"
  }
}
