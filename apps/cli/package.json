{
  "name": "@swoff/cli",
  "version": "0.3.14",
  "type": "module",
  "description": "CLI for Swoff - Offline-first web apps made easy",
  "bin": {
    "swoff": "bin/swoff"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/"
  ],
  "keywords": [
    "service-worker",
    "offline",
    "pwa",
    "caching"
  ],
  "author": "Swoff",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
