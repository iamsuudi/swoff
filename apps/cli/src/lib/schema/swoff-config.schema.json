{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swoff.netlify.app/schema/v1.json",
  "title": "Swoff Configuration",
  "description": "Configuration for the Swoff offline-first service worker system",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the schema version",
      "example": "https://swoff.netlify.app/schema/v1.json"
    },
    "enabled": {
      "type": "boolean",
      "description": "Enable or disable config-driven generation",
      "default": true
    },
    "version": {
      "type": "string",
      "description": "Service Worker version. Use 'from-package' to read from package.json, or specify semver like '1.0.0'",
      "default": "from-package",
      "oneOf": [
        { "const": "from-package" },
        { "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      ]
    },
    "minSupportedVersion": {
      "type": "string",
      "description": "Minimum supported version for forced updates. Clients running older versions will be forced to update.",
      "default": "0.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "serviceWorker": {
      "type": "object",
      "description": "Service Worker configuration",
      "properties": {
        "autoRegister": {
          "type": "boolean",
          "description": "Automatically register new service worker versions when detected. When false, dispatches sw-update-available event for manual registration via handleUpdateApproved().",
          "default": true
        },
        "autoActivate": {
          "type": "boolean",
          "description": "Automatically activate newly registered service workers (skipWaiting). Only applies when a new version is registered — use with autoRegister for fully silent updates, or wait for user consent then call handleUpdateApproved().",
          "default": false
        },
        "defaultStrategy": {
          "type": "string",
          "description": "Default caching strategy for all requests",
          "default": "cache-first",
          "enum": ["cache-first", "network-first", "stale-while-revalidate", "cache-only", "network-only"]
        },
        "strategies": {
          "type": "object",
          "description": "Custom cache strategies for specific URL patterns",
          "additionalProperties": {
            "type": "string",
            "enum": ["cache-first", "network-first", "stale-while-revalidate", "cache-only", "network-only"]
          },
          "patternProperties": {
            ".*": {
              "type": "string"
            }
          }
        },
        "maxCacheEntries": {
          "type": "integer",
          "description": "Maximum number of cached entries (0 disables trimming)",
          "default": 100,
          "minimum": 0
        },
        "maxCacheAge": {
          "type": "integer",
          "description": "Maximum age of cached entries in milliseconds (0 disables trimming)",
          "default": 604800000,
          "minimum": 0
        },
        "runtimeCacheName": {
          "type": "string",
          "description": "Custom runtime cache name",
          "default": "swoff-runtime",
          "pattern": "^[a-zA-Z0-9-_]+$"
        },
        "clearRuntimeOnUpdate": {
          "type": "boolean",
          "description": "Delete runtime cache on SW activate. Use as a security measure: when true, cached API responses are cleared on every SW update, preventing poisoned data from persisting.",
          "default": false
        },
        "navigationMode": {
          "type": "string",
          "description": "How navigation requests are handled. 'spa' falls back to spaEntry on cache miss. 'default' uses the strategy as-is without special navigation handling.",
          "default": "spa",
          "enum": ["spa", "default"]
        },
        "spaEntry": {
          "type": "string",
          "description": "Fallback URL for navigation requests when navigationMode is 'spa'",
          "default": "/index.html"
        }
      },
      "required": ["autoRegister", "autoActivate", "defaultStrategy"]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles - enable/disable specific functionality",
      "properties": {
        "versionedSw": {
          "type": "boolean",
          "description": "Enable versioned service worker (prevents silent updates)",
          "default": true
        },
        "mutationQueue": {
          "type": "boolean",
          "description": "Queue offline writes and sync when back online",
          "default": false
        },
        "backgroundSync": {
          "type": "boolean",
          "description": "Enable Background Sync API (Chrome/Edge only)",
          "default": false
        },
        "pwa": {
          "type": "object",
          "description": "PWA installability configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable PWA installability (generate pwa-install.js + manifest.json)",
              "default": true
            },
            "preventDefaultInstall": {
              "type": "boolean",
              "description": "Prevent browser's native install prompt. When false, browser prompt shows naturally while event is captured. When true, prompt is suppressed and dev must call promptInstall() manually.",
              "default": false
            }
          },
          "required": ["enabled", "preventDefaultInstall"]
        },
        "auth": {
          "type": "boolean",
          "description": "Enable auth integration",
          "default": false
        },
        "crossTabSync": {
          "type": "boolean",
          "description": "Cross-tab cache invalidation sync",
          "default": true
        },
        "tagInvalidation": {
          "type": "boolean",
          "description": "Tag-based cache invalidation",
          "default": true
        },
        "clientRegistration": {
          "type": "boolean",
          "description": "Generate client-side SW registration code (sw-injector)",
          "default": true
        },
        "indexeddb": {
          "type": "object",
          "description": "IndexedDB storage configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Generate IndexedDB storage patterns",
              "default": false
            },
            "name": {
              "type": "string",
              "description": "Database name",
              "default": "app-db",
              "pattern": "^[a-zA-Z0-9-_]+$"
            },
            "stores": {
              "type": "array",
              "description": "Object store names (user defines their own schema)",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-_]+$"
              },
              "default": []
            }
          },
          "required": ["enabled", "name"]
        }
      },
      "required": ["versionedSw", "mutationQueue", "backgroundSync", "pwa", "auth", "crossTabSync", "tagInvalidation", "clientRegistration", "indexeddb"]
    },
    "build": {
      "type": "object",
      "description": "Build output configuration",
      "properties": {
        "outputDir": {
          "type": "string",
          "description": "Output directory for generated files",
          "default": "dist",
          "pattern": "^[^/\\\\]+$"
        },
        "swFilename": {
          "type": "string",
          "description": "Service worker output filename (without version)",
          "default": "sw",
          "pattern": "^[a-zA-Z0-9-_]+$"
        }
      },
      "required": ["outputDir", "swFilename"]
    }
  },
  "required": ["enabled", "version", "minSupportedVersion", "serviceWorker", "features", "build"],
  "additionalProperties": false
}
