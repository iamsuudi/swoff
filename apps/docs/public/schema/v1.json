{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swoff.netlify.app/schema/v1.json",
  "title": "Swoff Configuration",
  "description": "Configuration for the Swoff offline-first service worker system",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the schema version",
      "example": "https://swoff.netlify.app/schema/v1.json"
    },
    "enabled": {
      "type": "boolean",
      "description": "Enable or disable config-driven generation",
      "default": true
    },
    "framework": {
      "type": "string",
      "description": "Detected frontend framework. Used to generate framework-specific hooks and adapters. Set automatically by `swoff init`.",
      "default": "vanilla",
      "enum": ["react", "vue", "svelte", "vanilla"]
    },
    "features": {
      "type": "object",
      "description": "Feature toggles - enable/disable specific functionality",
      "properties": {
        "pwa": {
          "type": "object",
          "description": "PWA installability configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable PWA installability (generate pwa-install.js + manifest.json)",
              "default": true
            },
            "preventDefaultInstall": {
              "type": "boolean",
              "description": "Prevent browser's native install prompt. When false, browser prompt shows naturally while event is captured. When true, prompt is suppressed and dev must call promptInstall() manually.",
              "default": false
            }
          },
          "required": ["enabled", "preventDefaultInstall"]
        },
        "serviceWorker": {
          "type": "object",
          "description": "Service Worker configuration",
          "properties": {
            "version": {
              "type": "object",
              "description": "Service Worker versioning configuration",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable versioned service worker (versioned SW URL, version.json, update events). When disabled, uses a fixed SW URL with hash-based cache naming.",
                  "default": true
                },
                "source": {
                  "type": "string",
                  "description": "Version source. 'from-package' reads from package.json, 'manual' uses the value field.",
                  "default": "from-package",
                  "enum": ["from-package", "manual"]
                },
                "value": {
                  "type": "string",
                  "description": "Manual version value. Required when source is 'manual'. Must be semver (e.g., '1.0.0').",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "minSupportedVersion": {
                  "type": "string",
                  "description": "Minimum supported version for forced updates. Clients running older versions will be forced to update.",
                  "default": "0.0.0",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                }
              },
              "required": ["enabled", "source"]
            },
            "autoUpdate": {
              "type": "boolean",
              "description": "Automatically register new service worker versions when detected. When false, dispatches sw-update-available event for manual registration via handleUpdateApproved().",
              "default": true
            },
            "autoActivate": {
              "type": "boolean",
              "description": "Automatically activate newly registered service workers (skipWaiting). Only applies when a new version is registered — use with autoUpdate for fully silent updates, or wait for user consent then call handleUpdateApproved().",
              "default": false
            },
            "defaultStrategy": {
              "type": "string",
              "description": "Default caching strategy for all requests",
              "default": "cache-first",
              "enum": [
                "cache-first",
                "network-first",
                "stale-while-revalidate",
                "cache-only",
                "network-only"
              ]
            },
            "staleTime": {
              "type": "integer",
              "description": "Default stale time in seconds. Cached data is considered fresh for this duration. After expiry, the SW serves the cached copy but triggers a background refresh. 0 = always stale, undefined = never auto-stale.",
              "default": 0,
              "minimum": 0
            },
            "strategies": {
              "type": "object",
              "description": "Custom cache strategies for specific URL patterns. Each value can be a strategy name string, or an object with strategy, staleTime, maxCacheEntries, and maxCacheAge. staleTime overrides the global staleTime for matching routes.",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "cache-first",
                      "network-first",
                      "stale-while-revalidate",
                      "cache-only",
                      "network-only"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "strategy": {
                        "type": "string",
                        "enum": [
                          "cache-first",
                          "network-first",
                          "stale-while-revalidate",
                          "cache-only",
                          "network-only"
                        ]
                      },
                      "staleTime": {
                        "type": "integer",
                        "description": "Per-route stale time in seconds. Overrides global staleTime for this pattern.",
                        "minimum": 0
                      },
                      "maxCacheEntries": {
                        "type": "integer",
                        "description": "Maximum entries for this route pattern",
                        "minimum": 0
                      },
                      "maxCacheAge": {
                        "type": "integer",
                        "description": "Maximum age in milliseconds for this route pattern",
                        "minimum": 0
                      }
                    },
                    "required": ["strategy"]
                  }
                ]
              }
            },
            "maxCacheEntries": {
              "type": "integer",
              "description": "Maximum number of cached entries (0 disables trimming)",
              "default": 0,
              "minimum": 0
            },
            "maxCacheAge": {
              "type": "integer",
              "description": "Maximum age of cached entries in milliseconds (0 disables trimming)",
              "default": 0,
              "minimum": 0
            },
            "refetchOnWindowFocus": {
              "type": "boolean",
              "description": "Automatically refetch stale data when the browser tab gains focus. Configurable per-request in useCachedFetch.",
              "default": false
            },
            "refetchOnReconnect": {
              "type": "boolean",
              "description": "Automatically refetch stale data when the browser comes back online. Configurable per-request in useCachedFetch.",
              "default": false
            },
            "refetchInterval": {
              "type": "integer",
              "description": "Automatically refetch stale data every N seconds (0 disables). Configurable per-request in useCachedFetch.",
              "default": 0,
              "minimum": 0
            },
            "runtimeCacheName": {
              "type": "string",
              "description": "Custom runtime cache name",
              "default": "swoff-runtime",
              "pattern": "^[a-zA-Z0-9-_]+$"
            },
            "clearRuntimeOnUpdate": {
              "type": "boolean",
              "description": "Delete runtime cache on SW activate. Use as a security measure: when true, cached API responses are cleared on every SW update, preventing poisoned data from persisting.",
              "default": false
            },
            "navigationMode": {
              "type": "string",
              "description": "How navigation requests are handled. 'spa' falls back to spaEntry on cache miss. 'default' uses the strategy as-is without special navigation handling.",
              "default": "spa",
              "enum": ["spa", "default"]
            },
            "navigationPreload": {
              "type": "boolean",
              "description": "Enable Navigation Preload API in the service worker. Reduces startup latency for navigation requests by allowing the SW to fetch while the page boots.",
              "default": true
            },
            "cacheStrategy": {
              "type": "string",
              "description": "Controls which requests are processed by the SW cache strategy system. 'all' processes every GET/HEAD request. 'explicit-only' only processes requests with X-SW-Cache-Strategy header (set automatically by fetchWithCache()).",
              "default": "all",
              "enum": ["all", "explicit-only"]
            },
            "spaEntry": {
              "type": "string",
              "description": "Fallback URL for navigation requests when navigationMode is 'spa'",
              "default": "/index.html"
            }
          },
          "required": [
            "version",
            "autoUpdate",
            "autoActivate",
            "defaultStrategy"
          ]
        },
        "mutationQueue": {
          "oneOf": [
            { "type": "boolean", "description": "Enable offline mutation queue" },
            {
              "type": "object",
              "description": "Offline mutation queue configuration",
              "properties": {
                "enabled": { "type": "boolean", "description": "Enable offline mutation queue", "default": false },
                "batchSize": { "type": "integer", "description": "Mutations per progress event", "default": 1, "minimum": 1 },
                "batchDelayMs": { "type": "integer", "description": "Delay between mutations (rate limiting)", "default": 0, "minimum": 0 },
                "maxRetries": { "type": "integer", "description": "Max retries before dropping", "default": 5, "minimum": 1 },
                "retryBackoffMs": { "type": "integer", "description": "Exponential backoff base in ms", "default": 1000, "minimum": 0 }
              }
            }
          ]
        },
        "backgroundSync": {
          "type": "boolean",
          "description": "Enable Background Sync API (Chrome/Edge only)",
          "default": false
        },
        "auth": {
          "type": "object",
          "description": "Auth integration configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable auth integration",
              "default": false
            },
            "type": {
              "type": "string",
              "description": "Auth type — determines how auth headers are attached",
              "default": "bearer",
              "enum": ["cookie", "bearer", "custom"]
            },
            "refreshPath": {
              "type": "string",
              "description": "Token refresh endpoint path",
              "example": "/api/refresh"
            },
            "userEndpoint": {
              "type": "string",
              "description": "Current user API endpoint",
              "example": "/api/me"
            }
          },
          "required": ["enabled", "type"]
        },
        "crossTabSync": {
          "type": "boolean",
          "description": "Cross-tab cache invalidation sync",
          "default": true
        },
        "tagInvalidation": {
          "type": "boolean",
          "description": "Tag-based cache invalidation",
          "default": true
        },
        "graphql": {
          "oneOf": [
            { "type": "boolean", "description": "Enable GraphQL wrapper with body-hash caching" },
            {
              "type": "object",
              "description": "GraphQL client wrapper configuration",
              "properties": {
                "enabled": { "type": "boolean", "description": "Enable GraphQL wrapper", "default": false },
                "endpoint": { "type": "string", "description": "GraphQL API endpoint", "example": "/graphql" }
              }
            }
          ]
        },
        "pushNotifications": {
          "type": "object",
          "description": "Push notification configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable push notification support (generates push.ts client + SW push handlers)",
              "default": false
            },
            "vapidPublicKey": {
              "type": "string",
              "description": "VAPID public key for push subscription. Required when enabled. You can also pass it at runtime to subscribeToPush().",
              "example": "BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeghA5N1Fha7J3Ef4sQyKgOoF7m4wA1gPXi6gXqJxYd3o="
            }
          },
          "required": ["enabled"]
        }
      },
      "required": [
        "pwa",
        "serviceWorker",
        "mutationQueue",
        "backgroundSync",
        "auth",
        "crossTabSync",
        "tagInvalidation",
        "pushNotifications",
        "graphql"
      ]
    },
    "build": {
      "type": "object",
      "description": "Build output configuration",
      "properties": {
        "outputDir": {
          "type": "string",
          "description": "Output directory for generated files",
          "default": "dist",
          "pattern": "^[^/\\\\]+$"
        },
        "swFilename": {
          "type": "string",
          "description": "Service worker output filename (without version)",
          "default": "sw",
          "pattern": "^[a-zA-Z0-9-_]+$"
        }
      },
      "required": ["outputDir", "swFilename"]
    }
  },
  "required": ["enabled", "features", "build"],
  "additionalProperties": false
}
