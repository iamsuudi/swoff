{
  "$schema": "https://swoff.netlify.app/schema/v1.json",
  "framework": "tanstack-start-react",
  "features": {
    "serviceWorker": {
      "autoActivate": true,
      "strategy": {
        "default": "network-first"
      },
      "navigation": {
        "mode": "ssr",
        "fallback": "/offline"
      }
    }
  },
  "build": {
    "swOutput": "dist/client",
    "precacheDirs": {
      "dist/client": {
        "prefix": "/",
        "stripExtensions": [".html"],
        "stripSuffixes": ["index"]
      }
    }
  }
}
