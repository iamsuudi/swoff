{
  "$schema": "https://swoff.netlify.app/schema/v1.json",
  "framework": "tanstack-start-react",
  "features": {
    "serviceWorker": {
      "autoActivate": true,
      "strategy": {
        "default": "network-first",
        "patterns": {
          "/_serverFn/*": "network-only"
        }
      },
      "navigation": {
        "mode": "ssr",
        "fallback": "/offline"
      }
    }
  },
  "build": {
    "swOutput": "dist/client",
    "swFilename": "sw",
    "precacheDirs": {
      "dist/client": {
        "prefix": "/"
      }
    }
  }
}
