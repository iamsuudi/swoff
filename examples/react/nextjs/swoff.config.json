{
  "$schema": "https://swoff.netlify.app/schema/v1.json",
  "framework": "nextjs",
  "features": {
    "requestBatchWindowMs": 50,
    "pwa": {
      "enabled": true,
      "preventDefaultInstall": false
    },
    "serviceWorker": {
      "version": "hash",
      "autoActivate": true,
      "navigation": {
        "mode": "ssr",
        "preload": true,
        "fallback": "/offline",
        "precacheRoutes": []
      },
      "strategy": {
        "default": "network-first",
        "clearRuntimeOnUpdate": false,
        "maxRuntimeCacheAge": 2592000,
        "normalizeKey": false,
        "ignoreQueryParams": ["_rsc"],
        "timeout": 10,
        "patterns": {
          "/_next/static*": "cache-first"
        },
        "reactive": {
          "defaults": {
            "staleTime": 0,
            "refetchInterval": 0,
            "refetchOnReconnect": false,
            "refetchOnFocus": false
          }
        }
      }
    },
    "refetchQueue": {
      "retry": {
        "maxRetries": 3,
        "backoffMs": 1000,
        "maxBackoffMs": 10000,
        "jitterMs": 100
      }
    },
    "mutationQueue": {
      "enabled": true,
      "batchSize": 1,
      "batchDelayMs": 0,
      "backgroundSync": true,
      "retry": {
        "maxRetries": 5,
        "backoffMs": 1000,
        "maxBackoffMs": 30000,
        "jitterMs": 250
      }
    },
    "auth": {
      "enabled": true,
      "type": "cookie",
      "routePaths": ["/api/auth"]
    },
    "tagInvalidation": {
      "debounceMs": 0,
      "skipPrefixes": ["api", "v1", "v2", "v3", "rest", "graphql", "gql"],
      "patterns": {},
      "singularization": {},
      "cascading": {},
      "crossTabSync": true
    },
    "graphql": {
      "enabled": true,
      "endpoints": ["/graphql"]
    },
    "realtime": {
      "pushNotifications": true,
      "serverPush": {
        "enabled": true,
        "type": "sse",
        "endpoint": "/api/events",
        "reconnectDelayMs": 5000
      }
    }
  },
  "build": {
    "outputDir": "public",
    "swFilename": "sw",
    "precacheDirs": {
      ".next/static": { "prefix": "/_next/static" },
      ".next/server/app": {
        "prefix": "/",
        "extensions": [".html"],
        "stripExtension": true,
        "stripSuffixes": ["index"]
      }
    }
  }
}
